{
  "env": {
    "CLAUDE_CODE_DISABLE_WSL": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "GH_PROMPT_DISABLED": "1"
  },
  "permissions": {
    "deny": [
      "PowerShell",
      "PowerShell(*)",
      "Bash",
      "Bash(*)"
    ],
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep"
    ]
  }
}
